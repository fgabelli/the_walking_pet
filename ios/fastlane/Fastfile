default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Setup API Key for automated deployments
    api_key = app_store_connect_api_key(
      key_id: "26DG5SP85K",
      issuer_id: "69a6de7e-e9cf-47e3-e053-5b8c7c11a4d1",
      key_filepath: "/Users/f.gabelli/.gemini/asc_key.p8",
      duration: 1200,
      in_house: false
    )

    # 2. Increment build number
    # 2. Increment build number - DISABLED to rely on pubspec.yaml version
    # increment_build_number(xcodeproj: "Runner.xcodeproj")

    # 3. Build (Provisioning will be handled by Xcode/API Key session)
    build_app(
      workspace: "Runner.xcworkspace", 
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      export_team_id: "ARRQ93VN8X",
      output_directory: "../build/ios/ipa",
      output_name: "DOGZN.ipa",
      xcargs: "-allowProvisioningUpdates",
      xcodebuild_formatter: ''
    )

    # 4. Upload to TestFlight
    
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "../build/ios/ipa/DOGZN.ipa"
    )
  end

  desc "Upload existing IPA to TestFlight"
  lane :upload_only do
    api_key = app_store_connect_api_key(
      key_id: "26DG5SP85K",
      issuer_id: "69a6de7e-e9cf-47e3-e053-5b8c7c11a4d1",
      key_filepath: "/Users/f.gabelli/.gemini/asc_key.p8",
      duration: 1200,
      in_house: false
    )
    
    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/DOGZN.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Submit build to App Store Review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "26DG5SP85K",
      issuer_id: "69a6de7e-e9cf-47e3-e053-5b8c7c11a4d1",
      key_filepath: "/Users/f.gabelli/.gemini/asc_key.p8",
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "com.thewalkingpet.app",
      app_version: "1.2.1",
      build_number: "165",
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_app_version_update: false,
      precheck_include_in_app_purchases: false,
      release_notes: {
        "it" => "Novità nella versione 1.2.1:\n- Migliorata la schermata di avvio\n- Ottimizzazioni delle prestazioni\n- Correzioni di bug minori"
      },
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
