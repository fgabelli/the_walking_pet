rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public form: allow creating ad inquiries from landing page (no auth required)
    match /ad_inquiries/{docId} {
      allow create: if request.resource.data.keys().hasAll(['businessName', 'email', 'phone'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*[.].*');
      allow read, update, delete: if request.auth != null;
    }
    // Public form: allow creating web_marketing_leads (newsletter, etc)
    match /web_marketing_leads/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['email', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*[.].*')
        && request.resource.data.consent == true;
      allow read, update, delete: if request.auth != null;
    }

    // Public form: allow creating takedown_requests (GDPR content takedown by users or non-users)
    match /takedown_requests/{docId} {
      allow create: if request.resource.data.keys().hasAll(['reporterEmail', 'reporterName', 'reason', 'contentDescription'])
                    && request.resource.data.reporterEmail is string
                    && request.resource.data.reporterEmail.matches('.*@.*[.].*');
      allow read, update, delete: if request.auth != null;
    }

    // Authenticated users: allow everything
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
